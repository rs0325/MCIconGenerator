{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "channel",
    "sequence",
    "toolVersion",
    "minimumBootstrapProtocol",
    "platforms"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "channel": {
      "const": "stable"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "toolVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "minimumBootstrapProtocol": {
      "const": 2
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "host",
          "payload",
          "runtimeDescriptor"
        ],
        "properties": {
          "host": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "os",
              "arch"
            ],
            "properties": {
              "os": {
                "enum": [
                  "macos",
                  "windows",
                  "linux"
                ]
              },
              "arch": {
                "enum": [
                  "aarch64",
                  "x86_64"
                ]
              }
            }
          },
          "payload": {
            "allOf": [
              {
                "$ref": "managed-runtime-v1.schema.json#/$defs/artifact"
              },
              {
                "properties": {
                  "role": {
                    "const": "tool-payload"
                  },
                  "format": {
                    "const": "zip"
                  }
                }
              }
            ]
          },
          "runtimeDescriptor": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rs0325/MCIconGenerator/schemas/stable-update-v1.schema.json",
  "title": "CLI stable更新manifest v1",
  "description": "CLI更新channelの署名対象。固定版ライブラリは参照しない。"
}
