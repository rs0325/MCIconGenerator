{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MCIconGenerator worker v1の要求・応答",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "type",
        "protocolVersion",
        "renderer",
        "contextProfile",
        "animationFrameZero"
      ],
      "properties": {
        "type": {
          "const": "ready"
        },
        "protocolVersion": {
          "const": 1
        },
        "renderer": {
          "type": "string"
        },
        "contextProfile": {
          "const": "canonical-v1"
        },
        "animationFrameZero": {
          "const": true
        }
      }
    },
    {
      "type": "object",
      "required": [
        "requestId",
        "command"
      ],
      "properties": {
        "requestId": {
          "$ref": "#/$defs/requestId"
        },
        "command": {
          "enum": [
            "catalog",
            "render",
            "shutdown"
          ]
        },
        "id": {
          "$ref": "#/$defs/resourceId"
        },
        "size": {
          "enum": [
            16,
            32,
            64,
            128,
            256,
            512
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "command": {
                "const": "render"
              }
            }
          },
          "then": {
            "required": [
              "id",
              "size",
              "path"
            ]
          }
        }
      ]
    },
    {
      "type": "object",
      "required": [
        "requestId",
        "type"
      ],
      "properties": {
        "requestId": {
          "$ref": "#/$defs/requestId"
        },
        "type": {
          "const": "result"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/catalogEntry"
          }
        },
        "result": {
          "type": "object",
          "required": [
            "path",
            "visiblePixels"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "visiblePixels": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "entries"
          ],
          "not": {
            "required": [
              "result"
            ]
          }
        },
        {
          "required": [
            "result"
          ],
          "not": {
            "required": [
              "entries"
            ]
          }
        },
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "entries"
                ]
              },
              {
                "required": [
                  "result"
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "type": "object",
      "required": [
        "requestId",
        "type",
        "code",
        "message"
      ],
      "properties": {
        "requestId": {
          "$ref": "#/$defs/requestId"
        },
        "type": {
          "const": "error"
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        }
      }
    }
  ],
  "description": "正規のpeerが交換するメッセージ。runtimeでJSON Schema全体を検証するものではない。取消はwire commandではなくcore tokenとcontainer終了で行う。",
  "$defs": {
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "resourceId": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9/._-]+$"
    },
    "catalogEntry": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/resourceId"
        },
        "kind": {
          "enum": [
            "item",
            "block"
          ]
        },
        "status": {
          "enum": [
            "available",
            "no_item_form"
          ]
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resourceId"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "available"
              }
            }
          },
          "then": {
            "required": [
              "blocks"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "no_item_form"
              }
            }
          },
          "then": {
            "properties": {
              "kind": {
                "const": "block"
              }
            }
          }
        }
      ]
    }
  }
}
