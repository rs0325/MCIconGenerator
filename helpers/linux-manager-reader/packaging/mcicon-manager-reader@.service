[Unit]
Description=MCIcon fixed user manager observation

[Service]
Type=simple
ExecStart=/usr/libexec/mcicon-manager-reader
StandardInput=socket
StandardOutput=socket
StandardError=journal
User=root
Group=root
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_PTRACE
RestrictAddressFamilies=AF_UNIX
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
PrivateDevices=yes
PrivateTmp=yes
PrivateUsers=no
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
TasksMax=1
MemoryMax=32M
LimitNOFILE=16
RuntimeMaxSec=2500ms
TimeoutStartSec=250ms
TimeoutStopSec=250ms
KillMode=control-group
SendSIGKILL=yes
Restart=no
